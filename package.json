{
  "name": "foodlek",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/db/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "data:usda": "python3 scripts/data/extract_usda_subset.py",
    "data:ciqual": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/data/import-ciqual.ts",
    "retail:sync": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/retail/sync-open-prices.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "vitest run --project integration",
    "prix:enseigne": "cross-env NODE_OPTIONS=--conditions=react-server tsx scripts/retail/sync-observed-prices.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "better-auth": "1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
