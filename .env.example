# Copy to .env.local (Next.js) and .env (scripts), then fill in.
# Never commit real secrets.

# PostgreSQL 16+
DATABASE_URL=postgres://foodlek:foodlek@localhost:5432/foodlek

# 32+ random characters: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-with-a-long-random-secret-string

# Public URL of the app (used for auth callbacks and emails)
APP_URL=http://localhost:3000

# Emails (password reset, verification): console | resend | disabled
# "console" prints emails in the server output and only works in development.
MAIL_TRANSPORT=console
MAIL_FROM=FOODLEK <no-reply@example.com>
RESEND_API_KEY=

# Require e-mail verification before sign-in (needs a working mail transport)
REQUIRE_EMAIL_VERIFICATION=false

# Open data providers (Open Food Facts / Open Prices) require a contact in the User-Agent.
OPEN_DATA_CONTACT=you@example.com
# Enable live price lookups from Open Prices (crowd-sourced, ODbL)
OPEN_PRICES_ENABLED=false

# Public contact shown in the privacy policy (data protection requests)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
